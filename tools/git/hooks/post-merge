#!/bin/sh
# Stock Git LFS post-merge hook plus the translation guard.
#
# Without the guard, "git merge upstream/main" reinstates every locale folder we
# deleted upstream modifies them, Git resolves it as CONFLICT (modify/delete) and
# writes their version of the file. Git cannot consult a .gitattributes merge
# driver for delete/modify conflicts, so the only reliable place to fix this is
# a hook. See tools/git/README.md.
command -v git-lfs >/dev/null 2>&1 || { echo >&2 "\nThis repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks').\n"; exit 2; }
git lfs post-merge "$@"

hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sh "$hooks_dir/../purge-translations.sh"
