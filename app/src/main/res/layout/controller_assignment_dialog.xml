                style="@style/SmallActionButton.Secondary"
                android:layout_marginEnd="6dp"
                android:text="@string/common_ui_reset" />

            <Button
                android:id="@+id/BTNAssignP3"
                style="@style/SmallActionButton.Accent"
                android:text="@string/session_gamepad_assign" />
        </com.google.android.flexbox.FlexboxLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_outline" />

        <!-- Player 4 -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            app:alignItems="center"
            app:flexWrap="nowrap"
            app:justifyContent="flex_start">

            <CheckBox
                android:id="@+id/CBPlayer4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_player_4"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVPlayer4DeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/inter"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/session_gamepad_not_assigned"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                app:layout_flexGrow="1"
                app:layout_minWidth="0dp" />

            <CheckBox
                android:id="@+id/CBVibrateP4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_vibrate"
                android:textColor="@color/settings_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/BTNMacrosP4"
                style="@style/SmallActionButton.Secondary"
