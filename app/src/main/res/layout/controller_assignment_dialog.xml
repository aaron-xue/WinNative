<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVRestartRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/container_config_restart_required"
            android:textColor="@color/settings_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Player 1 -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            app:alignItems="center"
            app:flexWrap="nowrap"
            app:justifyContent="flex_start">

            <CheckBox
                android:id="@+id/CBPlayer1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_player_1"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVPlayer1DeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/inter"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/session_gamepad_not_assigned"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                app:layout_flexGrow="1"
                app:layout_minWidth="0dp" />

            <CheckBox
                android:id="@+id/CBVibrateP1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_vibrate"
                android:textColor="@color/settings_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/BTNMacrosP1"
                style="@style/SmallActionButton.Secondary"
                android:layout_marginEnd="6dp"
                android:text="@string/session_gamepad_macros" />

            <Button
                android:id="@+id/BTNResetP1"
                style="@style/SmallActionButton.Secondary"
                android:layout_marginEnd="6dp"
                android:text="@string/common_ui_reset" />

            <Button
                android:id="@+id/BTNAssignP1"
                style="@style/SmallActionButton.Accent"
                android:text="@string/session_gamepad_assign" />
        </com.google.android.flexbox.FlexboxLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_outline" />

        <!-- Player 2 -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            app:alignItems="center"
            app:flexWrap="nowrap"
            app:justifyContent="flex_start">

            <CheckBox
                android:id="@+id/CBPlayer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_player_2"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVPlayer2DeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/inter"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/session_gamepad_not_assigned"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                app:layout_flexGrow="1"
                app:layout_minWidth="0dp" />

            <CheckBox
                android:id="@+id/CBVibrateP2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_vibrate"
                android:textColor="@color/settings_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/BTNMacrosP2"
                style="@style/SmallActionButton.Secondary"
                android:layout_marginEnd="6dp"
                android:text="@string/session_gamepad_macros" />

            <Button
                android:id="@+id/BTNResetP2"
                style="@style/SmallActionButton.Secondary"
                android:layout_marginEnd="6dp"
                android:text="@string/common_ui_reset" />

            <Button
                android:id="@+id/BTNAssignP2"
                style="@style/SmallActionButton.Accent"
                android:text="@string/session_gamepad_assign" />
        </com.google.android.flexbox.FlexboxLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_outline" />

        <!-- Player 3 -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            app:alignItems="center"
            app:flexWrap="nowrap"
            app:justifyContent="flex_start">

            <CheckBox
                android:id="@+id/CBPlayer3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_player_3"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TVPlayer3DeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/inter"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/session_gamepad_not_assigned"
                android:textColor="@color/settings_text_primary"
                android:textSize="13sp"
                app:layout_flexGrow="1"
                app:layout_minWidth="0dp" />

            <CheckBox
                android:id="@+id/CBVibrateP3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:button="@drawable/multi_select_checkbox"
                android:fontFamily="@font/inter"
                android:text="@string/session_gamepad_vibrate"
                android:textColor="@color/settings_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/BTNMacrosP3"
                style="@style/SmallActionButton.Secondary"
