<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x20000"
        android:required="true" />

    <!-- Library module: do NOT set application-level icon/label/etc. (the app provides them). -->
    <application>

        <meta-data
            android:name="org.godotengine.editor.version"
            android:value="3.6.2.stable" />

        <!-- Built-in game entry: launched from the WinNative library, not from the home screen. -->
        <activity
            android:name="com.godot.game.GodotApp"
            android:exported="true"
            android:excludeFromRecents="false"
            android:launchMode="singleInstancePerTask"
            android:screenOrientation="userLandscape"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"
            android:resizeableActivity="true"
            android:theme="@style/GodotAppSplashTheme">
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />
        </activity>

        <!-- Same as GodotApp but ignores back / edge-swipe so the game isn't force-quit
             (which would ProcessPhoenix.killProcess the whole host app). This is what
             BuiltinGames launches.

             Runs in its own ":brotato" process so the heavy Godot engine's memory stays
             out of the library (UnifiedActivity) process. That keeps the stopped library
             activity from being reclaimed under memory pressure while the game is on top,
             so finishing the game returns straight to the library instead of rebuilding it. -->
        <activity
            android:name="org.godotengine.godot.WinNativeGodotApp"
            android:exported="true"
            android:excludeFromRecents="false"
            android:process=":brotato"
            android:launchMode="singleTop"
            android:screenOrientation="userLandscape"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="false"
            android:theme="@style/GodotAppSplashTheme">
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />
        </activity>

        <meta-data
            android:name="org.godotengine.library.version"
            android:value="3.6.2.stable" />

        <service android:name="org.godotengine.godot.GodotDownloaderService" />

        <activity
            android:name="org.godotengine.godot.utils.ProcessPhoenix"
            android:exported="false"
            android:process=":phoenix"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            Use a distinct provider class name (GodotFileProvider) so the manifest merger
            treats this as a SEPARATE provider from WinNative's own androidx FileProvider
            (tileprovider / WinlatorFilesProvider). Authority stays unique per app id.
        -->
        <provider
            android:name="org.godotengine.godot.utils.GodotFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/godot_provider_paths" />
        </provider>
    </application>

    <uses-permission android:name="android.permission.MANAGE_DOCUMENTS" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_USER_DICTIONARY" />
</manifest>
